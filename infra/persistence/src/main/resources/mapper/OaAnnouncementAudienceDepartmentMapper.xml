<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.archetom.crm.infra.persistence.mysql.mapper.OaAnnouncementAudienceDepartmentMapper">

    <insert id="insertBatch">
        INSERT INTO oa_announcement_audience_department
            (tenant_id, announcement_id, department_id)
        VALUES
        <foreach collection="departmentIds" item="departmentId" separator=",">
            (#{tenantId}, #{announcementId}, #{departmentId})
        </foreach>
    </insert>
</mapper>
