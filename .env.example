# Production runtime example. Copy to an untracked .env and replace every blank value.
# Spring Boot does not load .env automatically; inject it through your deployment
# platform or docker run --env-file .env. Never use the local Compose DB passwords in production.
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:mysql://db.example.test:3306/atom_db?sslMode=VERIFY_IDENTITY&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Canonical unpadded base64url key, at least 32 random bytes. Keep stable across replicas/restarts.
ATOM_AUTHENTICATION_SIGNING_KEY=
ATOM_AUTHENTICATION_PASSWORD_RESET_URL=https://crm.example.test/password-reset/confirm

# Production requires this SMTP welcome adapter or your own UserNotificationPort.
ATOM_USER_NOTIFICATION_MAIL_ENABLED=true
ATOM_USER_NOTIFICATION_MAIL_FROM=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_CONNECTIONTIMEOUT=5000
SPRING_MAIL_PROPERTIES_MAIL_SMTP_TIMEOUT=5000
SPRING_MAIL_PROPERTIES_MAIL_SMTP_WRITETIMEOUT=5000

# Password recovery is a separate capability; enable after verifying SMTP delivery.
ATOM_AUTHENTICATION_PASSWORD_RESET_MAIL_ENABLED=false
ATOM_AUTHENTICATION_PASSWORD_RESET_MAIL_FROM=
